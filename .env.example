# Copy this file to .env and fill in values. Never commit .env.

# Required for Competitive, Qualitative, Reviewer, and Writer. Paste a key
# in the GUI instead if you prefer. OpenAI (sk-...) or Gemini (AIza...).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=

# LangSmith / LangChain tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=equity-research-pipeline

# Market data, filings, and search
FINNHUB_API_KEY=
TAVILY_API_KEY=
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
NEWSAPI_KEY=

# SEC EDGAR requires a descriptive User-Agent: AppName and a real contact email
SEC_USER_AGENT="MyResearchProject/1.0 (yourname@gmail.com)"

# Optional: refresh Damodaran's published spread table into the local cache.
# The dated file data/damodaran_spreads.json remains the source of truth if refresh fails.
# DAMODARAN_REFRESH=0

# Optional SQLite cache TTLs in seconds (defaults: statements 12h, SEC 7d, ticker map 24h)
# CACHE_TTL_STATEMENTS=43200
# CACHE_TTL_SEC=604800
# CACHE_DB_PATH=
